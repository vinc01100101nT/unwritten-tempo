# EVERY SECRET AND EVERY ADDRESS THE GAME'S PROGRAMS NEED, IN ONE FILE.
#
# Copy this to settings.env (same folder) and fill it in. settings.env is never committed — it holds the
# secrets. Each machine has its own: your desk's says "this machine" everywhere; the rented server's names the
# rented server.
#
# WHO READS IT: the sign-in service, the character server (charserver/run.sh), the world server
# (tools/run-map-server.sh), the database backup (tools/backup-database.sh), the encrypting front door
# (deploy/Caddyfile, started with --envfile), the launcher build (tools/build-launcher.sh), the game build
# (tools/build-game.sh), and the editor when it was opened from the Dock rather than a terminal.
#
# A value typed in front of a command in the terminal always wins over this file.
#
# ONLY the three "what players are handed" addresses at the bottom ever leave this machine inside the game or
# the launcher. Nothing else in this file is ever copied into anything a player downloads.

# ---- Secrets ------------------------------------------------------------------------------------------------

# Where Postgres is. Locally this is usually the database you created by hand.
DATABASE_URL=postgres://localhost:5432/unwritten

# Signs the proof of identity a player carries. Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# How the character server and the world servers recognise EACH OTHER. Never a player's sign-in token and never
# interchangeable with one; the character server refuses to start without it. Generate one with:
#   openssl rand -base64 32
SERVER_SECRET=

# ---- This machine: where its own programs find each other ----------------------------------------------------

# The sign-in service and the character server, as the editor and the world server reach them. Game builds
# carry these too, until the public addresses at the bottom are filled in.
ACCOUNTS_URL=http://localhost:8080
CHAR_SERVER_URL=http://localhost:8081

# The address this machine's world server is reached at — by the character server, which pushes each arriving
# character to it, AND by players, who are sent there to play. 127.0.0.1 on your desk; the rented server's
# public address there.
MAP_SERVER_ADDRESS=127.0.0.1

# Which addresses the sign-in service and the character server answer on. Every address by default, which is
# what a desk needs. On the rented server set it to 127.0.0.1, so the encrypting front door is the only way in.
# BIND_HOST=0.0.0.0

# The folder the launcher downloads updates from, on the machine that hands them out. When set, the character
# server turns away any copy of the game whose version differs from that folder's version.txt. Leave it unset
# on your desk.
# PATCH_DIR=/srv/unwritten/patch

# The player wiki's address, allowed to read the public server status. Several may be separated by commas.
# WIKI_ORIGINS=http://127.0.0.1:8099

# Ports and timings — the defaults are right unless two programs collide.
# PORT=8080                      (the sign-in service)
# CHAR_SERVER_PORT=8081
# MAP_SERVER_ARRIVALS_PORT=7788  (the world server's door for the character server — not the players' port)
# GAME_SERVER_PORT=7777          (the world server's door for players)
# ACCESS_TOKEN_SECONDS=900
# REFRESH_TOKEN_DAYS=30
# MAX_PROGRESS_BYTES=262144

# ---- What players are handed: the rented server's public addresses -------------------------------------------
#
# Written into every game build and every launcher build made on this machine, and served by the encrypting
# front door. Leave the first two empty until the rented server exists: builds then carry this machine's
# addresses (above), exactly as before.

PUBLIC_ACCOUNTS_URL=
PUBLIC_CHAR_SERVER_URL=

# Where the launcher downloads updates from.
PATCH_URL=

# Where the certificate authority writes when a certificate cannot be renewed. A real address you read.
CERT_EMAIL=
