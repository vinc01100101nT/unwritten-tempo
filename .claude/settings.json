{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/hook-analytics/perf_gate.py\"",
            "timeout": 10,
            "statusMessage": "perf-gate"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/check-before-done.py\"",
            "timeout": 200,
            "statusMessage": "verify"
          }
        ]
      }
    ]
  }
}
