{
  "permissions": {
    "allow": [
      "Bash(git rm *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/tools/hooks/run-hook.sh\" tools/hook-analytics/perf_gate.py",
            "timeout": 10,
            "statusMessage": "perf-gate"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/tools/hooks/run-hook.sh\" tools/check-before-done.py",
            "timeout": 200,
            "statusMessage": "verify"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/tools/hooks/run-hook.sh\" tools/hook-analytics/guard_check.py",
            "timeout": 10,
            "statusMessage": "guards"
          }
        ]
      }
    ]
  }
}
