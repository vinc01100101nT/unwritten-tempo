<Project Sdk="Microsoft.NET.Sdk">

  <!-- THE PROGRAM A MAC PLAYER DOWNLOADS AND OPENS: the Mac twin of ../launcher-updater. It fetches the launcher
       (../launcher) into the player's own folder, keeps it up to date, and starts it. Its own project, never sharing
       a file with the Windows one, so no Mac change can alter the Windows program. Compiled straight to a Mac program,
       which only a Mac can do; tools/build-launcher.sh builds it for both kinds of Mac chip and joins the two. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>unwritten-launcher</AssemblyName>
    <RootNamespace>UnwrittenLauncherUpdater</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <!-- .NET from Microsoft rather than this Mac's Homebrew copy, for the reason ../launcher/UnwrittenLauncher.csproj gives. -->
    <NetCoreTargetingPackRoot>$(MSBuildProjectDirectory)/obj/no-local-dotnet</NetCoreTargetingPackRoot>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
  </PropertyGroup>

  <!-- THE GAME'S OWN COLOURS AND FONT, carried inside the program from where the game keeps them, never copied. -->
  <ItemGroup>
    <EmbeddedResource Include="../prototypes/ui-tokens.json" LogicalName="ui-tokens.json" />
    <EmbeddedResource Include="../unity/Assets/3_Data/Resources/Fonts/DejaVuSansCondensed.ttf" LogicalName="font.ttf" />
  </ItemGroup>

</Project>
