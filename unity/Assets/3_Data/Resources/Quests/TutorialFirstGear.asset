MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 106a9e95425d80943adccfcbc2e2d493, type: 3}
  m_Name: TutorialFirstGear
  m_EditorClassIdentifier: Assembly-CSharp::QuestDef
  id: tutorial.first-gear
  title: Your First Gear
  category: 0
  description: Gunnar the smith shows you how to fold the Sword you arrived with. A
    fold makes a piece worth more, and the first time you play this your folds are free.
  unlockCondition: 1
  steps:
  - id: talk-gunnar
    text: Talk to Gunnar the Smith.
    objective:
      kind: 0
      townspersonId: gunnar
      itemId: 
      folds: 1
    hints:
    - spot: 0
      text: Go to Gunnar the Smith and press F beside him.
  - id: fold-sword
    text: Fold your Sword five times.
    objective:
      kind: 2
      townspersonId: 
      itemId: item.sword
      folds: 5
    hints:
    - spot: 3
      text: Go back to the smith's list.
    - spot: 2
      text: Folding makes a piece stronger, one fold at a time.
    - spot: 5
      text: Pick your Sword.
    - spot: 6
      text: Fold it. What a fold costs is on the button.
  - id: wear-sword
    text: Wear your Sword.
    objective:
      kind: 3
      townspersonId: 
      itemId: item.sword
      folds: 1
    hints:
    - spot: 0
      text: Open your bag with B.
    - spot: 7
      text: Double-click your Sword to wear it.
