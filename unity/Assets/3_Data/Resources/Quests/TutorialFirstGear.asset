%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 106a9e95425d80943adccfcbc2e2d493, type: 3}
  m_Name: TutorialFirstGear
  m_EditorClassIdentifier: Assembly-CSharp::QuestDef
  id: tutorial.first-gear
  title: Your First Gear
  category: 0
  description: Gunnar the Smith makes gear from Copper and gold. The first time you
    play this, forging a sword, a chainmail and a pair of iron sabatons, and the folds
    that make them stronger, costs you nothing.
  unlockCondition: 1
  steps:
  - id: talk-gunnar
    text: Talk to Gunnar the Smith.
    objective:
      kind: 0
      townspersonId: gunnar
      itemId: 
      folds: 1
    hints:
    - spot: 0
      text: Go to Gunnar the Smith and press F beside him.
  - id: forge-sword
    text: Forge a Sword.
    objective:
      kind: 1
      townspersonId: 
      itemId: item.sword
      folds: 1
    hints:
    - spot: 3
      text: Go back to the smith's list.
    - spot: 1
      text: Forge makes a new piece from Copper and gold.
    - spot: 4
      text: Forge a Sword here. What it costs is on the row.
  - id: fold-sword
    text: Fold your Sword five times.
    objective:
      kind: 2
      townspersonId: 
      itemId: item.sword
      folds: 5
    hints:
    - spot: 3
      text: Go back to the smith's list.
    - spot: 2
      text: Folding makes a piece stronger, one fold at a time.
    - spot: 5
      text: Pick your Sword.
    - spot: 6
      text: Fold it. What a fold costs is on the button.
  - id: forge-chainmail
    text: Forge a Chainmail.
    objective:
      kind: 1
      townspersonId: 
      itemId: item.chainmail
      folds: 1
    hints:
    - spot: 3
      text: Go back to the smith's list.
    - spot: 1
      text: Forge makes a new piece from Copper and gold.
    - spot: 4
      text: Forge a Chainmail here. What it costs is on the row.
  - id: fold-chainmail
    text: Fold your Chainmail five times.
    objective:
      kind: 2
      townspersonId: 
      itemId: item.chainmail
      folds: 5
    hints:
    - spot: 3
      text: Go back to the smith's list.
    - spot: 2
      text: Folding makes a piece stronger, one fold at a time.
    - spot: 5
      text: Pick your Chainmail.
    - spot: 6
      text: Fold it. What a fold costs is on the button.
  - id: forge-sabatons
    text: Forge Iron Sabatons.
    objective:
      kind: 1
      townspersonId: 
      itemId: item.iron-sabatons
      folds: 1
    hints:
    - spot: 3
      text: Go back to the smith's list.
    - spot: 1
      text: Forge makes a new piece from Copper and gold.
    - spot: 4
      text: Forge Iron Sabatons here. What they cost is on the row.
  - id: fold-sabatons
    text: Fold your Iron Sabatons five times.
    objective:
      kind: 2
      townspersonId: 
      itemId: item.iron-sabatons
      folds: 5
    hints:
    - spot: 3
      text: Go back to the smith's list.
    - spot: 2
      text: Folding makes a piece stronger, one fold at a time.
    - spot: 5
      text: Pick your Iron Sabatons.
    - spot: 6
      text: Fold it. What a fold costs is on the button.
  - id: wear-sword
    text: Wear your Sword.
    objective:
      kind: 3
      townspersonId: 
      itemId: item.sword
      folds: 1
    hints:
    - spot: 0
      text: Open your bag with B.
    - spot: 7
      text: Double-click your Sword to wear it.
  - id: wear-chainmail
    text: Wear your Chainmail.
    objective:
      kind: 3
      townspersonId: 
      itemId: item.chainmail
      folds: 1
    hints:
    - spot: 0
      text: Open your bag with B.
    - spot: 7
      text: Double-click your Chainmail to wear it.
  - id: wear-sabatons
    text: Wear your Iron Sabatons.
    objective:
      kind: 3
      townspersonId: 
      itemId: item.iron-sabatons
      folds: 1
    hints:
    - spot: 0
      text: Open your bag with B.
    - spot: 7
      text: Double-click your Iron Sabatons to wear them.
