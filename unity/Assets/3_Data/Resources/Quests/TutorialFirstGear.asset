%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 106a9e95425d80943adccfcbc2e2d493, type: 3}
  m_Name: TutorialFirstGear
  m_EditorClassIdentifier: Assembly-CSharp::QuestDef
  id: tutorial.first-gear
  title: Your First Gear
  category: 0
  description: Gunnar the Smith makes gear from Copper and gold. You carry just enough
    for a sword, a chainmail and a shield, and the folds that make them stronger.
  givenAutomatically: 1
  steps:
  - id: talk-gunnar
    text: Talk to Gunnar the Smith.
    objective:
      kind: 0
      townspersonId: gunnar
      itemId: 
      folds: 1
    hints:
    - spot: 0
      text: Go to Gunnar the Smith and press F beside him.
  - id: forge-sword
    text: Forge a Sword.
    objective:
      kind: 1
      townspersonId: 
      itemId: item.sword
      folds: 1
    hints:
    - spot: 3
      text: Go back to the smith's list.
    - spot: 1
      text: Forge makes a new piece from Copper and gold.
    - spot: 4
      text: Forge a Sword here. What it costs is on the row.
  - id: fold-sword
    text: Fold your Sword twice.
    objective:
      kind: 2
      townspersonId: 
      itemId: item.sword
      folds: 2
    hints:
    - spot: 3
      text: Go back to the smith's list.
    - spot: 2
      text: Folding makes a piece stronger, one fold at a time.
    - spot: 5
      text: Pick your Sword.
    - spot: 6
      text: Fold it. Each fold costs Copper and gold.
  - id: forge-chainmail
    text: Forge a Chainmail.
    objective:
      kind: 1
      townspersonId: 
      itemId: item.chainmail
      folds: 1
    hints:
    - spot: 3
      text: Go back to the smith's list.
    - spot: 1
      text: Forge makes a new piece from Copper and gold.
    - spot: 4
      text: Forge a Chainmail here. What it costs is on the row.
  - id: fold-chainmail
    text: Fold your Chainmail twice.
    objective:
      kind: 2
      townspersonId: 
      itemId: item.chainmail
      folds: 2
    hints:
    - spot: 3
      text: Go back to the smith's list.
    - spot: 2
      text: Folding makes a piece stronger, one fold at a time.
    - spot: 5
      text: Pick your Chainmail.
    - spot: 6
      text: Fold it. Each fold costs Copper and gold.
  - id: forge-shield
    text: Forge an Iron Kite Shield.
    objective:
      kind: 1
      townspersonId: 
      itemId: item.iron-kite-shield
      folds: 1
    hints:
    - spot: 3
      text: Go back to the smith's list.
    - spot: 1
      text: Forge makes a new piece from Copper and gold.
    - spot: 4
      text: Forge an Iron Kite Shield here. What it costs is on the row.
  - id: fold-shield
    text: Fold your Iron Kite Shield twice.
    objective:
      kind: 2
      townspersonId: 
      itemId: item.iron-kite-shield
      folds: 2
    hints:
    - spot: 3
      text: Go back to the smith's list.
    - spot: 2
      text: Folding makes a piece stronger, one fold at a time.
    - spot: 5
      text: Pick your Iron Kite Shield.
    - spot: 6
      text: Fold it. Each fold costs Copper and gold.
  - id: wear-sword
    text: Wear your Sword.
    objective:
      kind: 3
      townspersonId: 
      itemId: item.sword
      folds: 1
    hints:
    - spot: 0
      text: Open your bag with B.
    - spot: 7
      text: Double-click your Sword to wear it.
  - id: wear-chainmail
    text: Wear your Chainmail.
    objective:
      kind: 3
      townspersonId: 
      itemId: item.chainmail
      folds: 1
    hints:
    - spot: 0
      text: Open your bag with B.
    - spot: 7
      text: Double-click your Chainmail to wear it.
  - id: wear-shield
    text: Wear your Iron Kite Shield.
    objective:
      kind: 3
      townspersonId: 
      itemId: item.iron-kite-shield
      folds: 1
    hints:
    - spot: 0
      text: Open your bag with B.
    - spot: 7
      text: Double-click your Iron Kite Shield to wear it.
