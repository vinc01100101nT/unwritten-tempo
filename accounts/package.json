{
  "name": "unwritten-accounts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Account + character service for unwritten: who you are, which characters you own, and their saves.",
  "scripts": {
    "dev": "node --env-file-if-exists=../settings.env --watch src/server.ts",
    "start": "node --env-file-if-exists=../settings.env src/server.ts",
    "migrate": "node --env-file-if-exists=../settings.env src/migrate.ts",
    "test": "node --env-file-if-exists=../settings.env test/smoke.ts",
    "sync-roster": "node scripts/sync-roster.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
