# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Where Postgres is. Locally this is usually the database you created by hand.
DATABASE_URL=postgres://localhost:5432/unwritten

# Signs the proof-of-identity the game carries. Any long random string; the C# game server will need the
# SAME value later so it can verify what this service issued. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Optional — sensible defaults are built in.
# PORT=8080
# Which addresses this service answers on. Every address by default, which is what a machine on your own
# desk needs. On a hosted machine set it to 127.0.0.1, so the only way in is through the encrypting proxy
# in front — see deploy/Caddyfile. Set the SAME value on the character server.
# BIND_HOST=0.0.0.0
# ACCESS_TOKEN_SECONDS=900
# REFRESH_TOKEN_DAYS=30
# MAX_PROGRESS_BYTES=262144
