# Claude Code machine-local settings (personal hooks/permissions)
.claude/settings.local.json

# game builds (server + client) — large, regenerated by tools/build-game.sh
builds/

# the guards heartbeat — a local record of which hooks actually ran on THIS machine
tools/hook-analytics/hook-heartbeat.json

# database backups (tools/backup-database.sh) — the live data, never in git
backups/

# every secret and address, one per machine (settings.env.example is the committed template)
settings.env

# Python leaves these beside every script it runs; regenerated on each run, never shared
__pycache__/

# Addressables flips a setting in here off and back on during every build; every value matches the package default
unity/ProjectSettings/ScriptableBuildPipeline.json
